[Unit]
Description=BMW Camera Voice Service (BMW MediaPlayer)
After=local-fs.target
RequiresMountsFor=/var/opt

[Service]
Type=simple
User=root
RuntimeDirectory=bmwcaminfo-voice
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/node /var/opt/bmwcaminfo-voice/current/voice.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=5
LimitCORE=1

[Install]
WantedBy=multi-user.target
